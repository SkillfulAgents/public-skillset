# Copy to /workspace/.env (or let agent-onboarding create it) and fill in.
# Run scripts with:  uv run --env-file .env ...

# --- Required -----------------------------------------------------------------
# Ahrefs API v3 key (Account settings -> API keys). Needs a plan with API access;
# Site Explorer endpoints (backlinks, refdomains, rankings) need the higher tiers.
AHREFS_API_KEY=

# Google Search Console: full JSON of a GCP service-account key, on ONE line.
# The service account's client_email must be added as a (Full) user on the GSC property.
GSC_SERVICE_ACCOUNT_JSON=

# --- Optional -----------------------------------------------------------------
# Unsplash API access key (free; for blog images via the stock-media skill).
# Openverse works keyless as a fallback.
UNSPLASH_ACCESS_KEY=

# CMS credentials — depends on your publishing path (set during onboarding), e.g.:
# SANITY_API_KEY=            # Sanity
# CONTENTFUL_MANAGEMENT_TOKEN=
# WORDPRESS_APP_PASSWORD=
# GHOST_ADMIN_API_KEY=
