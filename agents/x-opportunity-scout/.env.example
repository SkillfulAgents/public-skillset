# X Opportunity Scout — optional secrets
# The default setup needs NO keys (discovery uses the platform's built-in X API).
# Copy to .env only if you enable an optional integration below.

# Optional: cheaper discovery reads via twitterapi.io (BYOK, ~30x cheaper than built-in).
# Sign up at https://twitterapi.io and load credit.
# TWITTERAPI_IO_KEY=

# Optional: reply-to-mentions posting via the official X API (post_reply.py).
# Requires your own X developer app with OAuth 1.0a read-write user context.
# Note: X only allows API replies to posts whose author mentioned/quoted you.
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
